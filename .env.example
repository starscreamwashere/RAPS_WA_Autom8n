# ---- General ----
TZ=Asia/Kolkata

# ---- Postgres ----
POSTGRES_USER=raps
POSTGRES_PASSWORD=change-me
POSTGRES_DB=raps
# n8n gets its own database on the same server (created by db/init)
N8N_DB=n8n

# ---- API ----
API_PORT=3000
# Shared secret n8n sends as the x-api-key header
API_KEY=change-me-long-random-string

# ---- n8n ----
N8N_ENCRYPTION_KEY=change-me-long-random-string
N8N_HOST=your-static-domain.ngrok-free.app
WEBHOOK_URL=https://your-static-domain.ngrok-free.app/

# ---- Meta WhatsApp Cloud API ----
# PERMANENT System User token (not the 24h temp token from the API setup page)
WA_ACCESS_TOKEN=
# Trim whitespace: a trailing space here breaks every send call
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# Any string you choose; must match what you enter in the Meta webhook config
WA_VERIFY_TOKEN=change-me
# Used to verify X-Hub-Signature-256 on inbound webhooks (App Dashboard > App settings > Basic)
WA_APP_SECRET=
# One-time onboarding only (scripts/meta-onboard.mjs, docs/META_SETUP.md phase 5)
META_APP_ID=
META_CONFIG_ID=
# Language code of the approved owner_alert / customer_update templates
WA_TEMPLATE_LANG=en
# Graph API base (change only to test against a mock)
GRAPH_API_BASE=https://graph.facebook.com/v27.0

# ---- Owner / escalation ----
# Business WhatsApp number the bot runs on (customers message this; also the escalation number)
BUSINESS_PHONE=919082201911
# Owner's PERSONAL number (digits only, with country code, as Meta sends it).
# Messages from this number skip the AI and are treated as owner commands.
# Must be different from BUSINESS_PHONE. Exactly one number in v1.
OWNER_PHONE=
# Second alert channel for when WhatsApp itself breaks (number disconnected from
# the Cloud API): a push to the owner's phone. Install the ntfy app, subscribe to
# a long random topic, and put its URL here, e.g. https://ntfy.sh/raps-7f3k9q2m1x
ALERT_PUSH_URL=

# ---- ngrok (static domain so the webhook URL survives restarts) ----
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-static-domain.ngrok-free.app

# ---- LLM (used by the n8n AI Agent node) ----
# Launch: Google Gemini (free tier, key from Google AI Studio). In n8n the key
# goes into a credential named "Gemini (RAPS)"; this copy is for the scripts.
GEMINI_API_KEY=
# Models to try, in order (first = main, second = fallback in n8n): if the
# first hits its free quota or is retired, the next one answers. Fill from: node scripts/gemini-models.mjs --probe
# Tested Nov 2026: all 18 test conversations pass on gemini-3.5-flash-lite.
# Flash (non-Lite) models allow only ~20 requests/day/model on the free tier: too few.
LLM_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Later, when volume grows: Claude (claude-haiku-5-5, then claude-sonnet-5-5 if needed)
ANTHROPIC_API_KEY=
