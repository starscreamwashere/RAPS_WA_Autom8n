{
  "name": "RAPS · 2 · Outbox sender",
  "nodes": [
    {
      "id": "n-001",
      "name": "Every 30 seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      }
    },
    {
      "id": "n-002",
      "name": "Pending messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.RAPS_API_URL + \"/outbox/pending\" }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.RAPS_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      }
    },
    {
      "id": "n-003",
      "name": "Build WhatsApp payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Free text inside the 24h window, otherwise the approved template with the\n// message flattened into its single body variable\nconst m = $input.item.json;\nconst payload = m.send_as === 'text'\n  ? { messaging_product: 'whatsapp', recipient_type: 'individual', to: m.phone, type: 'text', text: { preview_url: false, body: m.text } }\n  : { messaging_product: 'whatsapp', recipient_type: 'individual', to: m.phone, type: 'template',\n      template: { name: m.template, language: { code: $env.WA_TEMPLATE_LANG || 'en' },\n        components: [{ type: 'body', parameters: m.variables.map((v) => ({ type: 'text', text: String(v).slice(0, 1000) })) }] } };\nreturn { json: { id: m.id, payload } };"
      }
    },
    {
      "id": "n-004",
      "name": "Send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.GRAPH_API_BASE || \"https://graph.facebook.com/v21.0\") + \"/\" + String($env.WA_PHONE_NUMBER_ID).trim() + \"/messages\" }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + String($env.WA_ACCESS_TOKEN).trim() }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "timeout": 20000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "n-005",
      "name": "Mark sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        900,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RAPS_API_URL + \"/outbox/\" + $('Build WhatsApp payload').item.json.id + \"/sent\" }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.RAPS_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      }
    },
    {
      "id": "n-006",
      "name": "Mark failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        900,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RAPS_API_URL + \"/outbox/\" + $('Build WhatsApp payload').item.json.id + \"/failed\" }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.RAPS_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ error: String($json.error?.message || $json.error || \"send failed\").slice(0, 500) }) }}"
      }
    }
  ],
  "connections": {
    "Every 30 seconds": {
      "main": [
        [
          {
            "node": "Pending messages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pending messages": {
      "main": [
        [
          {
            "node": "Build WhatsApp payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build WhatsApp payload": {
      "main": [
        [
          {
            "node": "Send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send": {
      "main": [
        [
          {
            "node": "Mark sent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mark failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "pinData": {},
  "meta": {
    "generatedBy": "scripts/build-workflows.mjs"
  },
  "id": "raps-2-outbox-sender"
}
